---
import BaseLayout from './BaseLayout.astro';import Breadcrumbs from '../components/Breadcrumbs.astro';import PageHeader from '../components/PageHeader.astro';
const {meta,eyebrow,title,description,status,crumbs}=Astro.props;
---
<BaseLayout {...meta} breadcrumbs={crumbs}><Breadcrumbs items={crumbs}/><PageHeader {eyebrow} {title} {description} {status}/><section class="section product-surface"><div class="container reading"><slot /></div></section></BaseLayout>
