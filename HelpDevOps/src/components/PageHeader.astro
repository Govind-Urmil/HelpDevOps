---
const { eyebrow, title, description, status } = Astro.props;
---
<header class="page-header"><div class="container reading"><span class="eyebrow">{eyebrow}</span><div class="title-row"><h1>{title}</h1>{status && <span class="badge warning">{status}</span>}</div><p class="lead">{description}</p><slot /></div></header>
