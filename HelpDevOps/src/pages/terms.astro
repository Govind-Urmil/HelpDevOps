---
import StatusPage from '../components/StatusPage.astro'; import {pageMetadata as m} from '../config/pages.js';
const sections=[
 {label:'USE',title:'Engineering assistance, not a substitute for review',text:'HelpDevOps is provided for informational and workflow assistance. Verify outputs before applying them to systems, especially production environments.'},
 {label:'LOCAL DATA',title:'Browser-local workspaces are optional and not backup',text:'Favorites, recent tool metadata, and explicitly saved workspaces may remain in this browser profile. They can be cleared or evicted and are not synchronized or recoverable by HelpDevOps.'},
 {label:'IMPORT & EXPORT',title:'You control and review portable workspace files',text:'Imported and exported workspace JSON may contain raw technical input. Review it before saving or sharing, protect sensitive data, and keep backups where appropriate.'},
 {label:'AVAILABILITY',title:'Capabilities may change',text:'Preview and in-development areas are not operational commitments. Current status is stated on each relevant page.'},
 {label:'RESPONSIBILITY',title:'You control execution',text:'HelpDevOps analyzes supported input locally but does not execute pasted commands. You remain responsible for commands and changes you choose to run.'}
];
---
<StatusPage meta={m.terms} eyebrow="TERMS" title="Terms of use" description="Use HelpDevOps as an engineering aid with appropriate independent review." sections={sections}/>
