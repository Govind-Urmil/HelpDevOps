---
import StatusPage from '../components/StatusPage.astro'; import {pageMetadata as m} from '../config/pages.js';
const sections=[
 {label:'LOCAL ANALYSIS',title:'Supported analysis runs in your browser',text:'Supported tool input is analyzed locally. It is not uploaded, transmitted, logged, or executed by HelpDevOps.'},
 {label:'SMALL PREFERENCES',title:'Favorites and recent tools are optional metadata',text:'HelpDevOps may remember tool IDs, timestamps, and Session Dock display preferences in localStorage. It does not place your last input or result into recent-tool history.'},
 {label:'EXPLICIT WORKSPACES',title:'Workspace content is saved only when you choose Save',text:'Explicitly saved workspaces use IndexedDB in this browser profile. There is no cloud sync, account recovery, or server copy. Browser cleanup, private mode, quota enforcement, or eviction may remove this data.'},
 {label:'SENSITIVE CONTENT',title:'Warnings reduce risk but cannot find every secret',text:'Saving and exporting perform conservative sensitive-content checks. Unmistakable private-key material is blocked; other suspicious values trigger a warning. Review and redact content yourself.'},
 {label:'IMPORT & EXPORT',title:'Workspace files remain local and untrusted',text:'Imports are selected by you, validated locally, and never uploaded. Exported JSON may contain raw input, so review it before sharing and delete copies you no longer need.'},
 {label:'YOUR CONTROL',title:'Export or clear local data at any time',text:'The Workspace page can export saved workspaces or clear HelpDevOps preferences and IndexedDB data. Analysis tools remain available if storage is disabled or unavailable.',link:{href:'/workspace/',label:'Open Local Data & Privacy controls'}}
];
---
<StatusPage meta={m.privacy} eyebrow="PRIVACY" title="Private by design, precise in wording" description="Local continuity is explicit, inspectable, optional, and independent from core analysis." sections={sections}/>
