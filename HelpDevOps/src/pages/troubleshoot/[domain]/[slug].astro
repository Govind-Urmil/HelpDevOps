---
// @ts-nocheck
import BaseLayout from '../../../layouts/BaseLayout.astro';import PageHeader from '../../../components/PageHeader.astro';import DiagnosticJourney from '../../../components/diagnostics/DiagnosticJourney.astro';import {publishedJourneys} from '../../../diagnostics/registry.js';
export function getStaticPaths(){return publishedJourneys.map(journey=>({params:{domain:journey.domain,slug:journey.slug},props:{journey}}))}
const {journey}=Astro.props;const meta={path:journey.path,title:`${journey.title} | HelpDevOps`,description:journey.summary};
---
<BaseLayout {...meta} breadcrumbs={[{label:'Home',href:'/'},{label:'Troubleshoot',href:'/troubleshoot/'},{label:journey.domain,href:`/troubleshoot/${journey.domain}/`},{label:journey.title,href:journey.path}]}>
<PageHeader eyebrow={`${journey.domain.toUpperCase()} · ${journey.status === 'reviewed' ? 'REVIEWED DIAGNOSTIC' : 'TECHNICAL REVIEW CANDIDATE'}`} title={journey.title} description={journey.summary}/>
<section class="section"><div class="container"><DiagnosticJourney {journey}/><aside class="reference-panel"><h2>Authoritative references</h2><ul>{journey.references.map(ref=><li><a href={ref.url} rel="noreferrer">{ref.title}</a></li>)}</ul><h3>First safe checks</h3><ul>{journey.firstChecks.map(item=><li><code>{item}</code></li>)}</ul></aside></div></section>
</BaseLayout>
