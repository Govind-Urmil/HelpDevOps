---
// @ts-nocheck
import BaseLayout from '../../../layouts/BaseLayout.astro';import PageHeader from '../../../components/PageHeader.astro';import {publishedJourneys,diagnosticDomains} from '../../../diagnostics/registry.js';
export function getStaticPaths(){return diagnosticDomains.map(domain=>({params:{domain},props:{domain,journeys:publishedJourneys.filter(j=>j.domain===domain)}}))}
const {domain,journeys}=Astro.props;const label=domain[0].toUpperCase()+domain.slice(1);const meta={path:`/troubleshoot/${domain}/`,title:`${label} Troubleshooting | HelpDevOps`,description:`Reviewed ${label} diagnostic journeys with evidence-first next steps.`};
---
<BaseLayout {...meta} breadcrumbs={[{label:'Home',href:'/'},{label:'Troubleshoot',href:'/troubleshoot/'},{label,href:`/troubleshoot/${domain}/`}]}> <PageHeader eyebrow="TROUBLESHOOTING HUB" title={`${label} troubleshooting`} description="Reviewed symptom-first journeys with read-only checks first, explicit risks, and recovery verification."/><section class="section"><div class="container tool-grid">{journeys.map(journey=><article class="tool-card"><span class="eyebrow">{journey.status === 'reviewed' ? 'REVIEWED' : 'TECHNICAL REVIEW'}</span><h2><a href={journey.path}>{journey.title}</a></h2><p>{journey.summary}</p><a class="button secondary" href={journey.path}>Start diagnosis</a></article>)}</div></section></BaseLayout>
