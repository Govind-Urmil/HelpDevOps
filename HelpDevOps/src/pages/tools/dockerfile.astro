---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import AnalysisResult from '../../components/results/AnalysisResult.astro';
import examples from '../../tools/dockerfile/examples.json';
import resources from '../../tools/dockerfile/resources.json';
const meta={path:'/tools/dockerfile/',title:'Dockerfile Analyzer | HelpDevOps',description:'Inspect Dockerfile structure, selected build risks, and maintainability signals without executing a build.'};
---
<BaseLayout {...meta} breadcrumbs={[{label:'Home',href:'/'},{label:'Tools',href:'/tools/'},{label:'Dockerfile Analyzer',href:'/tools/dockerfile/'}]}>
  <PageHeader eyebrow="CONTAINERS · AVAILABLE" title="Dockerfile Analyzer" description="Inspect Dockerfile structure, selected build risks, and maintainability signals without executing a build." />
  <section class="section"><div class="container tool-workspace" data-dockerfile-root data-tool-root>
    <div class="tool-input-panel"><label for="dockerfile-input">Dockerfile input</label><textarea id="dockerfile-input" rows="16" data-tool-input placeholder="Paste a Dockerfile…"></textarea><div class="example-row">{examples.map(example=><button type="button" data-example={example.input}>{example.label}</button>)}</div><div class="tool-actions"><button class="button primary" type="button" data-inspect>Inspect</button><button class="button ghost" type="button" data-clear>Clear</button></div></div>
    <AnalysisResult />
    <aside class="reference-panel"><h2>Dockerfile inspection</h2><p>Input stays in this browser tab unless you explicitly save a workspace.</p><h3>Visible limitations</h3><ul>{resources.limitations.map(item=><li>{item}</li>)}</ul><h3>Authoritative references</h3><ul>{resources.references.map(item=><li><a href={item.url} rel="noreferrer">{item.title}</a></li>)}</ul></aside>
  </div></section>
</BaseLayout>
<script>
  // @ts-nocheck
  import {analyzeDockerfile} from '../../tools/dockerfile/analyzer.js';
  const root=document.querySelector('[data-dockerfile-root]');const input=root.querySelector('[data-tool-input]');
  const fill=result=>{const q=s=>root.querySelector(s);const list=(s,items)=>{q(s).replaceChildren(...(items?.length?items:['None for this result.']).map(item=>{const li=document.createElement('li');li.textContent=typeof item==='string'?item:item.label;return li;}))};q('[data-result-kind]').textContent=(result.kind||'unknown').toUpperCase();q('[data-result-title]').textContent=result.title;q('[data-result-status]').textContent=result.status.toUpperCase();q('[data-result-summary]').textContent=result.summary;list('[data-result-evidence]',[...(result.evidence||[]).map(e=>`${e.signal}: ${e.excerpt}`),...(result.findings||[])]);list('[data-result-actions]',result.actions);list('[data-result-checked]',result.checked);list('[data-result-not-checked]',result.notChecked);list('[data-result-next]',result.nextActions);const wrap=q('[data-formatted-wrap]');wrap.hidden=!result.formatted;if(result.formatted)q('[data-formatted-output]').textContent=result.formatted;const panel=q('[data-analysis-result]');panel.hidden=false;panel.focus()};
  root.querySelector('[data-inspect]').addEventListener('click',()=>fill(analyzeDockerfile(input.value)));root.querySelector('[data-clear]').addEventListener('click',()=>{input.value='';root.querySelector('[data-analysis-result]').hidden=true;input.focus()});root.querySelectorAll('[data-example]').forEach(button=>button.addEventListener('click',()=>{input.value=button.dataset.example;input.focus()}));root.querySelector('[data-copy-output]')?.addEventListener('click',async()=>navigator.clipboard.writeText(root.querySelector('[data-formatted-output]').textContent));
</script>
