---
import BaseLayout from '../../layouts/BaseLayout.astro';import PageHeader from '../../components/PageHeader.astro';import resources from '../../tools/git-reference/resources.json';const meta={path:'/tools/git-reference/',title:'Git Reference Toolkit | HelpDevOps',description:'Validate Git reference syntax and explain a conservative revision subset locally.'};
---
<BaseLayout {...meta}><PageHeader eyebrow="GIT · AVAILABLE" title="Git Reference Toolkit" description="Keep ref-name validation separate from revision syntax explanation. No repository is accessed."/><section class="section"><div class="container tool-workspace" data-tool-root><div class="tool-input-panel"><label for="git-input">Git name or revision expression</label><input id="git-input" data-input value="feature/add-login"/><div class="tool-actions"><select data-mode aria-label="Analysis mode"><option value="branch">Branch name</option><option value="tag">Tag name</option><option value="full">Fully qualified ref</option><option value="revision">Revision explainer</option></select><label><input type="checkbox" data-lower/> Lowercase suggestion explicitly</label><button class="button primary" data-analyze>Analyze</button><button class="button secondary" data-suggest>Suggest name</button><button class="button ghost" data-clear>Clear</button></div><p data-status aria-live="polite"></p><pre data-output></pre></div><aside class="reference-panel"><h2>Limits</h2><ul>{resources.limitations.map(x=><li>{x}</li>)}</ul></aside></div></section></BaseLayout>
<script>
// @ts-nocheck
import {validateRef,suggestRef,explainRevision} from '../../tools/git-reference/analyzer.js';const r=document.querySelector('[data-tool-root]'),i=r.querySelector('[data-input]'),o=r.querySelector('[data-output]'),s=r.querySelector('[data-status]');r.querySelector('[data-analyze]').onclick=()=>{const mode=r.querySelector('[data-mode]').value,x=mode==='revision'?explainRevision(i.value):validateRef(i.value,mode);s.textContent=x.title;o.textContent=`${x.summary||''}\n${(x.diagnostics||[]).join('\n')}\n${(x.notChecked||[]).join('\n')}`};r.querySelector('[data-suggest]').onclick=()=>{const x=suggestRef(i.value,{lowercase:r.querySelector('[data-lower]').checked});s.textContent='Suggestion created without replacing the original.';o.textContent=`Original: ${x.original}\nSuggestion: ${x.suggestion}\nChanges: ${x.changes.join(', ')||'none'}\nRemaining: ${x.remaining.join(', ')||'none'}`};r.querySelector('[data-clear]').onclick=()=>{i.value='';o.textContent='';s.textContent='';i.focus()}</script>
