---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import AnalysisResult from '../../components/results/AnalysisResult.astro';
import examples from '../../tools/cron/examples.json';
import resources from '../../tools/cron/resources.json';
const meta={path:'/tools/cron/',title:'Cron Analyzer | HelpDevOps',description:'Inspect and explain common five-field cron schedules locally with visible coverage and limitations.'};
---
<BaseLayout {...meta} breadcrumbs={[{label:'Home',href:'/'},{label:'Tools',href:'/tools/'},{label:'Cron Analyzer',href:'/tools/cron/'}]}>
  <PageHeader eyebrow="AUTOMATION · AVAILABLE" title="Cron Analyzer" description="Inspect common five-field cron expressions without uploading them." />
  <section class="section"><div class="container tool-workspace" data-cron-root data-tool-root>
    <div class="tool-input-panel"><label for="cron-input">Cron expression or user crontab line</label><textarea id="cron-input" rows="7" data-cron-input placeholder="*/5 * * * *"></textarea><div class="example-row">{examples.map(example=><button type="button" data-example={example.input}>{example.label}</button>)}</div><div class="tool-actions"><button class="button primary" type="button" data-cron-analyze>Analyze cron</button><button class="button ghost" type="button" data-clear>Clear</button></div></div>
    <AnalysisResult />
    <aside class="reference-panel"><h2>Supported scope</h2><p>Common five-field schedules, optional commands, lists, ranges, steps, comments, and common macros.</p><h3>Visible limitations</h3><ul>{resources.limitations.map(item=><li>{item}</li>)}</ul><a href={resources.references[0].url} rel="noreferrer">Open the POSIX crontab reference →</a></aside>
  </div></section>
</BaseLayout>
<script>
  // @ts-nocheck
  import {analyzeCron} from '../../tools/cron/analyzer.js';
  const root=document.querySelector('[data-cron-root]');
  const fill=result=>{const q=s=>root.querySelector(s);const list=(s,items)=>{q(s).replaceChildren(...(items?.length?items:['None for this result.']).map(item=>{const li=document.createElement('li');li.textContent=typeof item==='string'?item:item.label;return li;}))};q('[data-result-kind]').textContent='CRON';q('[data-result-title]').textContent=result.title;q('[data-result-status]').textContent=result.status.toUpperCase();q('[data-result-summary]').textContent=result.summary;list('[data-result-evidence]',[...(result.evidence||[]).map(e=>`${e.signal}: ${e.excerpt}`),...(result.findings||[])]);list('[data-result-actions]',result.actions);list('[data-result-checked]',result.checked);list('[data-result-not-checked]',result.notChecked);list('[data-result-next]',result.nextActions);const panel=q('[data-analysis-result]');panel.hidden=false;panel.focus()};
  const input=root.querySelector('[data-cron-input]');root.querySelector('[data-cron-analyze]').addEventListener('click',()=>fill(analyzeCron(input.value)));root.querySelector('[data-clear]').addEventListener('click',()=>{input.value='';root.querySelector('[data-analysis-result]').hidden=true;input.focus()});root.querySelectorAll('[data-example]').forEach(button=>button.addEventListener('click',()=>{input.value=button.dataset.example;input.focus()}));
</script>
