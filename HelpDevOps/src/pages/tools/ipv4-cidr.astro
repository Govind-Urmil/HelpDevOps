---
import BaseLayout from '../../layouts/BaseLayout.astro';import PageHeader from '../../components/PageHeader.astro';import resources from '../../tools/ipv4-cidr/resources.json';const meta={path:'/tools/ipv4-cidr/',title:'IPv4 CIDR Calculator | HelpDevOps',description:'Calculate IPv4 subnet boundaries locally with /31 and /32 context.'};
---
<BaseLayout {...meta}><PageHeader eyebrow="NETWORKING · AVAILABLE" title="IPv4 CIDR Calculator" description="Deterministic unsigned IPv4 subnet arithmetic and local special-purpose classification."/><section class="section"><div class="container tool-workspace" data-tool-root><div class="tool-input-panel"><label for="cidr-input">IPv4 CIDR</label><input id="cidr-input" data-input value="192.168.1.34/24"/><div class="tool-actions"><button class="button primary" data-calculate>Calculate</button><button class="button ghost" data-clear>Clear</button></div><p data-status aria-live="polite"></p><pre data-output></pre></div><aside class="reference-panel"><h2>Limits</h2><ul>{resources.limitations.map(x=><li>{x}</li>)}</ul><p>IANA registry reviewed {resources.iana.reviewed}.</p></aside></div></section></BaseLayout>
<script>
// @ts-nocheck
import {calculateIPv4} from '../../tools/ipv4-cidr/analyzer.js';const r=document.querySelector('[data-tool-root]'),i=r.querySelector('[data-input]'),o=r.querySelector('[data-output]'),s=r.querySelector('[data-status]');r.querySelector('[data-calculate]').onclick=()=>{const x=calculateIPv4({cidr:i.value});s.textContent=x.status==='valid'?'Calculation completed locally.':x.summary;o.textContent=x.status==='valid'?`Address: ${x.address}/${x.prefix}\nMask: ${x.mask}\nWildcard: ${x.wildcard}\nNetwork: ${x.network}\nBroadcast: ${x.broadcast}\nFirst: ${x.first}\nLast: ${x.last}\nTotal: ${x.total}\nUsable: ${x.usable}\nBinary: ${x.binary}\nClassification: ${x.classifications.map(y=>y.name).join(', ')||'No local special-purpose match'}`:''};r.querySelector('[data-clear]').onclick=()=>{i.value='';o.textContent='';s.textContent='';i.focus()}</script>
