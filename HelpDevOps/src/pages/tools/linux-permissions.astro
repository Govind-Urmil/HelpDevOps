---
import BaseLayout from '../../layouts/BaseLayout.astro';import PageHeader from '../../components/PageHeader.astro';import resources from '../../tools/linux-permissions/resources.json';const meta={path:'/tools/linux-permissions/',title:'Linux Permissions Calculator | HelpDevOps',description:'Convert Linux numeric and symbolic permission bits locally.'};
---
<BaseLayout {...meta}><PageHeader eyebrow="LINUX · AVAILABLE" title="Linux Permissions Calculator" description="Convert octal and symbolic permission bits with correct setuid, setgid, and sticky notation."/><section class="section"><div class="container tool-workspace" data-tool-root><div class="tool-input-panel"><label for="permissions-input">Numeric or symbolic mode</label><input id="permissions-input" data-input value="0755"/><fieldset><legend>Context</legend><label><input type="radio" name="context" value="file" checked/> Regular file</label><label><input type="radio" name="context" value="directory"/> Directory</label></fieldset><div class="tool-actions"><button class="button primary" data-calculate>Explain permissions</button><button class="button ghost" data-clear>Clear</button></div><p data-status aria-live="polite"></p><pre data-output></pre></div><aside class="reference-panel"><h2>Cautions</h2><ul>{resources.cautions.map(x=><li>{x.text}</li>)}</ul><h3>Limits</h3><ul>{resources.limitations.map(x=><li>{x}</li>)}</ul></aside></div></section></BaseLayout>
<script>
// @ts-nocheck
import {analyzePermissions} from '../../tools/linux-permissions/analyzer.js';const r=document.querySelector('[data-tool-root]'),i=r.querySelector('[data-input]'),o=r.querySelector('[data-output]'),s=r.querySelector('[data-status]');r.querySelector('[data-calculate]').onclick=()=>{const x=analyzePermissions(i.value,r.querySelector('input[name=context]:checked').value);s.textContent=x.status==='valid'?'Permission conversion completed.':x.summary;o.textContent=x.status==='valid'?`Numeric: ${x.numeric}\nSymbolic: ${x.symbolic}\nContext: ${x.context}\n${x.summary}\nCautions: ${x.cautions.join(' ')||'None triggered.'}\nSuggested command form: chmod ${x.numeric}`:''};r.querySelector('[data-clear]').onclick=()=>{i.value='';o.textContent='';s.textContent='';i.focus()}</script>
