[
  {
    "id": "sys-start",
    "nodeKind": "question",
    "title": "What state is reported?",
    "summary": "Distinguish missing/masked from failed or rate-limited.",
    "why": "Each requires different evidence.",
    "risk": "read-only",
    "commands": [
      {
        "command": "systemctl status <service> --no-pager",
        "purpose": "Show state and exit status."
      },
      {
        "command": "journalctl -u <service> -b --no-pager",
        "purpose": "Read current-boot logs; access may require privileges."
      }
    ],
    "choices": [
      {
        "id": "missing",
        "label": "Not found/masked",
        "nextNodeId": "sys-unit"
      },
      {
        "id": "failed",
        "label": "Failed",
        "nextNodeId": "sys-failure"
      },
      {
        "id": "limit",
        "label": "Start limit",
        "nextNodeId": "sys-limit"
      },
      {
        "id": "unknown",
        "label": "Unclear",
        "nextNodeId": "sys-escalate"
      }
    ]
  },
