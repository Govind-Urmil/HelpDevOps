---
import AnalysisResult from './results/AnalysisResult.astro';
---
<section class="universal-card" aria-labelledby="universal-title" data-analyzer-root>
  <div class="universal-top"><div><span class="eyebrow">UNIVERSAL INPUT · DETERMINISTIC</span><h2 id="universal-title">What are you working on?</h2></div><span class="badge">LOCAL-ONLY</span></div>
  <label class="sr-only" for="universal-input">Paste JSON, YAML, or a common cron expression</label>
  <textarea id="universal-input" rows="6" placeholder="Paste JSON, YAML, or a common cron expression…" data-analysis-input></textarea>
  <div class="input-footer"><p><span class="pulse" aria-hidden="true"></span> Nothing is uploaded or stored automatically. Supported analysis runs in this browser.</p><button class="button primary" type="button" data-analyze>Analyze input <span aria-hidden="true">→</span></button></div>
  <div class="example-row"><button type="button" data-example="*/5 * * * *">Cron example</button><button type="button" data-example='{"service":"api","replicas":2}'>JSON example</button><button type="button" data-example={'services:\n  web:\n    image: nginx:1.27'}>YAML example</button></div>
  <AnalysisResult />
</section>
<script>
  // @ts-nocheck
  import {analyzeInput} from '../core/analyze-input.js';
  const targetFor=(kind,text)=>{const map={cron:{toolId:'cron',path:'/tools/cron/',key:'cron-input'},json:{toolId:'structured-data',path:'/tools/structured-data/',key:'structured-input'},yaml:{toolId:'structured-data',path:'/tools/structured-data/',key:'structured-input'},compose:{toolId:'structured-data',path:'/tools/structured-data/',key:'structured-input'},kubernetes:{toolId:'structured-data',path:'/tools/structured-data/',key:'structured-input'},'ipv4-cidr':{toolId:'ipv4-cidr',path:'/tools/ipv4-cidr/',key:'cidr-input'},'linux-permissions':{toolId:'linux-permissions',path:'/tools/linux-permissions/',key:'permissions-input'},'git-ref':{toolId:'git-reference',path:'/tools/git-reference/',key:'git-input'}};const target=map[kind];return target?{...target,state:{toolId:target.toolId,toolSchemaVersion:1,input:{[target.key]:text},options:{sourcePath:'/'},resultSnapshot:null}}:null};
  const fill=(root,result,inputText)=>{const q=s=>root.querySelector(s);const list=(s,items)=>{q(s).replaceChildren(...(items?.length?items:['None for this result.']).map(item=>{const li=document.createElement('li');li.textContent=typeof item==='string'?item:item.label;return li;}))};q('[data-result-kind]').textContent=(result.kind||'unknown').toUpperCase();q('[data-result-title]').textContent=result.title;q('[data-result-status]').textContent=result.status.toUpperCase();q('[data-result-summary]').textContent=result.summary;list('[data-result-evidence]',[...(result.evidence||[]).map(e=>`${e.signal}: ${e.excerpt}`),...(result.findings||[])]);list('[data-result-actions]',result.actions);list('[data-result-checked]',result.checked);list('[data-result-not-checked]',result.notChecked);list('[data-result-next]',result.nextActions);const wrap=q('[data-formatted-wrap]');wrap.hidden=!result.formatted;if(result.formatted)q('[data-formatted-output]').textContent=result.formatted;const target=targetFor(result.kind,inputText);const sendWrap=q('[data-send-wrap]');sendWrap.hidden=!target;const send=q('[data-send-result]');if(target){send.textContent=`Open in ${target.toolId.replaceAll('-',' ')} →`;send.onclick=()=>{sessionStorage.setItem('helpdevops.transfer.v1',JSON.stringify({contractVersion:1,source:'universal-input',state:target.state}));location.href=target.path;};}const panel=q('[data-analysis-result]');panel.hidden=false;panel.focus();};
  document.querySelectorAll('[data-analyzer-root]').forEach(root=>{const input=root.querySelector('[data-analysis-input]');root.querySelector('[data-analyze]')?.addEventListener('click',()=>fill(root,analyzeInput(input.value),input.value));root.querySelectorAll('[data-example]').forEach(button=>button.addEventListener('click',()=>{input.value=button.dataset.example;input.focus()}));root.querySelector('[data-copy-output]')?.addEventListener('click',async()=>navigator.clipboard.writeText(root.querySelector('[data-formatted-output]').textContent));});
</script>
