---
import AnalysisResult from './results/AnalysisResult.astro';
---
<section class="universal-card" aria-labelledby="universal-title" data-analyzer-root>
  <div class="universal-top"><div><span class="eyebrow">UNIVERSAL INPUT · DETERMINISTIC</span><h2 id="universal-title">What are you working on?</h2></div><span class="badge">LOCAL-ONLY</span></div>
  <label class="sr-only" for="universal-input">Paste supported DevOps evidence, JSON, YAML, Dockerfile, Compose, Kubernetes, or Cron</label>
  <label class="context-hint" for="universal-context">Input context <select id="universal-context" data-analysis-context><option value="auto">Auto-detect</option><option value="symptom">Error or symptom</option><option value="command-output">Command output</option><option value="configuration">Configuration</option><option value="reference">Command/reference lookup</option></select></label>
  <textarea id="universal-input" rows="6" placeholder="Paste supported DevOps evidence, JSON, YAML, Dockerfile, Compose, Kubernetes, or Cron…" data-analysis-input></textarea>
  <div class="input-footer"><p><span class="pulse" aria-hidden="true"></span> Nothing is uploaded or stored automatically. Supported analysis runs in this browser.</p><button class="button primary" type="button" data-analyze>Analyze input <span aria-hidden="true">→</span></button></div>
  <div class="example-row"><button type="button" data-example="*/5 * * * *">Cron example</button><button type="button" data-example='{"service":"api","replicas":2}'>JSON example</button><button type="button" data-example={'services:\n  web:\n    image: nginx:1.27'}>Compose example</button><button type="button" data-example={'FROM node:22-bookworm\nWORKDIR /app\nCOPY . .\nUSER node\nCMD [\"node\", \"server.js\"]'}>Dockerfile example</button></div>
  <AnalysisResult />
</section>
<script>
  // @ts-nocheck
  import {orchestrateInput} from '../core/analyze-input.js';import {withNextActionLayer} from '../core/contracts.js';
  import {publishedJourneys} from '../diagnostics/registry.js';
  const targetFor=(kind,text)=>{if(kind?.startsWith('evidence:')){return{toolId:'evidence-interpreter',path:'/interpret/',key:'evidence-input',state:{toolId:'evidence-interpreter',toolSchemaVersion:1,input:{'evidence-input':text,'evidence-source':kind.slice('evidence:'.length)},options:{sourcePath:'/'},resultSnapshot:null}};}if(kind?.startsWith('diagnostic:')){const id=kind.slice('diagnostic:'.length);const journey=publishedJourneys.find(item=>item.id===id);if(journey)return{toolId:journey.id,path:journey.path,key:'journeyId',state:{toolId:journey.id,toolSchemaVersion:1,input:{journeyId:journey.id,currentNodeId:journey.entryNodeId,answers:'[]'},options:{sourcePath:'/'},resultSnapshot:null}};}const map={cron:{toolId:'cron',path:'/tools/cron/',key:'cron-input'},json:{toolId:'structured-data',path:'/tools/structured-data/',key:'structured-input'},yaml:{toolId:'structured-data',path:'/tools/structured-data/',key:'structured-input'},compose:{toolId:'docker-compose',path:'/tools/docker-compose/',key:'compose-input'},kubernetes:{toolId:'kubernetes-manifest',path:'/tools/kubernetes-manifest/',key:'kubernetes-input'},dockerfile:{toolId:'dockerfile',path:'/tools/dockerfile/',key:'dockerfile-input'},'ipv4-cidr':{toolId:'ipv4-cidr',path:'/tools/ipv4-cidr/',key:'cidr-input'},'linux-permissions':{toolId:'linux-permissions',path:'/tools/linux-permissions/',key:'permissions-input'},'git-ref':{toolId:'git-reference',path:'/tools/git-reference/',key:'git-input'}};const target=map[kind];return target?{...target,state:{toolId:target.toolId,toolSchemaVersion:1,input:{[target.key]:text},options:{sourcePath:'/'},resultSnapshot:null}}:null};
  const fill=(root,result,inputText)=>{result=withNextActionLayer(result);const layer=result.nextActionLayer;const q=s=>root.querySelector(s);const list=(s,items)=>{q(s).replaceChildren(...(items?.length?items:['None for this result.']).map(item=>{const li=document.createElement('li');const label=typeof item==='string'?item:(item.label||item.message||item.path||String(item));const path=typeof item==='object'&&item?item.path:(typeof item==='string'&&item.startsWith('/')?item:null);if(path&&/^\/(?!\/)[A-Za-z0-9_./-]*$/.test(path)){const a=document.createElement('a');a.href=path;a.textContent=label;li.append(a)}else li.textContent=label;return li;}))};q('[data-result-kind]').textContent=(result.kind||'unknown').toUpperCase();q('[data-result-title]').textContent=result.title;q('[data-result-status]').textContent=result.status.toUpperCase();q('[data-result-summary]').textContent=result.summary;list('[data-result-evidence]',layer.observed);list('[data-result-meaning]',layer.meaning);list('[data-result-actions]',layer.continueTo);list('[data-result-not-checked]',layer.unknowns);list('[data-result-next]',layer.checks);list('[data-result-verification]',layer.verification);const wrap=q('[data-formatted-wrap]');wrap.hidden=!result.formatted;if(result.formatted)q('[data-formatted-output]').textContent=result.formatted;const target=targetFor(result.kind,inputText);const sendWrap=q('[data-send-wrap]');sendWrap.hidden=!target;const send=q('[data-send-result]');if(target){send.textContent=`Open in ${target.toolId.replaceAll('-',' ')} →`;send.onclick=()=>{sessionStorage.setItem('helpdevops.transfer.v1',JSON.stringify({contractVersion:1,source:'universal-input',state:target.state}));location.href=target.path;};}const brief=q('[data-build-incident-brief]');brief.hidden=false;brief.onclick=()=>{sessionStorage.setItem('helpdevops.incident-brief-transfer.v1',JSON.stringify({contractVersion:1,source:'universal-input',expiresAt:Date.now()+300000,data:{summary:result.title,symptom:result.summary,context:`Universal Input · ${result.kind}`,observations:layer.observed.join('\n'),unknowns:layer.unknowns.join('\n'),checks:(result.checked||[]).join('\n'),verification:layer.verification.join('\n'),nextStep:layer.checks.join('\n')}}));location.href='/incident-brief/';};const panel=q('[data-analysis-result]');panel.dataset.resultRenderedKind=result.kind||'unknown';panel.hidden=false;panel.focus();};
  document.querySelectorAll('[data-analyzer-root]').forEach(root=>{const input=root.querySelector('[data-analysis-input]'),context=root.querySelector('[data-analysis-context]');root.querySelector('[data-analyze]')?.addEventListener('click',async()=>fill(root,await orchestrateInput(input.value,context?.value||'auto'),input.value));root.querySelectorAll('[data-example]').forEach(button=>button.addEventListener('click',()=>{input.value=button.dataset.example;input.focus()}));root.querySelector('[data-copy-output]')?.addEventListener('click',async()=>navigator.clipboard.writeText(root.querySelector('[data-formatted-output]').textContent));for(const event of ['dragenter','dragover'])input.addEventListener(event,e=>{e.preventDefault();root.dataset.dragActive='true'});for(const event of ['dragleave','drop'])input.addEventListener(event,e=>{e.preventDefault();root.dataset.dragActive='false'});input.addEventListener('drop',e=>{const text=e.dataTransfer?.getData('text/plain');if(text){input.value=text;input.dispatchEvent(new Event('input',{bubbles:true}))}});});
</script>
