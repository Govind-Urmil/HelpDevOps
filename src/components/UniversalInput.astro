---
import AnalysisResult from './results/AnalysisResult.astro';
---
<section class="universal-card" aria-labelledby="universal-title" data-analyzer-root>
  <div class="universal-top"><div><span class="eyebrow">UNIVERSAL INPUT &middot; DETERMINISTIC</span><h2 id="universal-title">What are you working on?</h2></div><span class="badge">LOCAL-ONLY</span></div>
  <label class="sr-only" for="universal-input">Paste supported DevOps evidence, JSON, YAML, Dockerfile, Compose, Kubernetes, or Cron</label>
  <label class="context-hint" for="universal-context">Input context <select id="universal-context" data-analysis-context><option value="auto">Auto-detect</option><option value="symptom">Error or symptom</option><option value="command-output">Command output</option><option value="configuration">Configuration</option><option value="reference">Command/reference lookup</option></select></label>
  <textarea id="universal-input" rows="6" placeholder="Paste supported DevOps evidence, JSON, YAML, Dockerfile, Compose, Kubernetes, or Cron&hellip;" data-analysis-input></textarea>
  <div class="input-footer"><p><span class="pulse" aria-hidden="true"></span> Nothing is uploaded or stored automatically. Supported analysis runs in this browser.</p><button class="button primary" type="button" data-analyze>Analyze input <span aria-hidden="true">&rarr;</span></button></div>
  <div class="example-row"><button type="button" data-example="*/5 * * * *">Cron example</button><button type="button" data-example='{"service":"api","replicas":2}'>JSON example</button><button type="button" data-example={'services:\n  web:\n    image: nginx:1.27'}>Compose example</button><button type="button" data-example={'FROM node:22-bookworm\nWORKDIR /app\nCOPY . .\nUSER node\nCMD [\"node\", \"server.js\"]'}>Dockerfile example</button></div>
  <AnalysisResult />
</section>
<script>
  // @ts-nocheck
  import {orchestrateInput} from '../core/analyze-input.js';import {withNextActionLayer} from '../core/contracts.js';
  import publishedJourneys from '../generated/diagnostic-search-index.json';
  const targetFromDestination=(descriptor,kind,text)=>{if(!descriptor?.path)return null;const toolId=descriptor.toolId;if(!toolId)return{path:descriptor.path,toolId:'reviewed guidance',state:null};const journey=publishedJourneys.find(item=>item.id===toolId);if(journey)return{path:descriptor.path,toolId,state:{toolId,toolSchemaVersion:1,input:{journeyId:toolId,currentNodeId:journey.entryNodeId,answers:'[]'},options:{sourcePath:'/'},resultSnapshot:null}};const key=descriptor.inputKey;if(!key)return{path:descriptor.path,toolId,state:null};const transferInput={[key]:text};if(toolId==='evidence-interpreter'&&kind?.startsWith('evidence:'))transferInput['evidence-source']=kind.slice('evidence:'.length);return{path:descriptor.path,toolId,state:{toolId,toolSchemaVersion:1,input:transferInput,options:{sourcePath:'/'},resultSnapshot:null}};};
  const fill=(root,result,inputText)=>{result=withNextActionLayer(result);const layer=result.nextActionLayer;const q=s=>root.querySelector(s);const list=(s,items)=>{q(s).replaceChildren(...(items?.length?items:['None for this result.']).map(item=>{const li=document.createElement('li');const rawLabel=typeof item==='string'?item:(item.label||item.message||item.path||String(item));const label=String(rawLabel).startsWith('/')?(publishedJourneys.find(entry=>entry.path===rawLabel)?.title||(/knowledge/.test(rawLabel)?'Open related operational guidance':'Open related troubleshooting guidance')):rawLabel;const path=typeof item==='object'&&item?item.path:(typeof item==='string'&&item.startsWith('/')?item:null);if(path&&/^\/(?!\/)[A-Za-z0-9_./-]*$/.test(path)){const a=document.createElement('a');a.href=path;a.textContent=label;li.append(a)}else li.textContent=label;return li;}))};q('[data-result-kind]').textContent=(result.kind||'unknown').toUpperCase();q('[data-result-title]').textContent=result.title;q('[data-result-status]').textContent=result.status.toUpperCase();q('[data-result-summary]').textContent=result.summary;q('[data-result-type]').textContent=result.resultType||'UNSUPPORTED';q('[data-result-technology]').textContent=result.technology||'unknown';const confidence=q('[data-result-confidence]'),hasConfidence=Number(result.confidenceScore)>0;confidence.previousElementSibling.textContent=hasConfidence?'Confidence':'';confidence.textContent=hasConfidence?(result.confidenceBand||'INSUFFICIENT'):'';q('[data-result-parser]').textContent=result.parser||'none';list('[data-result-evidence]',layer.observed);list('[data-result-meaning]',layer.meaning);list('[data-result-actions]',layer.continueTo);list('[data-result-not-checked]',layer.unknowns);list('[data-result-next]',layer.checks);list('[data-result-verification]',layer.verification);list('[data-result-explanation]',[result.explanation||result.summary]);list('[data-result-alternatives]',(result.alternativeCandidates||[]).map(item=>`${item.technology}: ${item.explanation} (${item.confidenceBand})`));list('[data-result-rejected]',(result.rejectedCandidates||[]).map(item=>`${item.technology}: ${item.rejectionReason||item.explanation}`));const wrap=q('[data-formatted-wrap]');wrap.hidden=!result.formatted;if(result.formatted)q('[data-formatted-output]').textContent=result.formatted;const target=['EXACT_MATCH','STRUCTURED_INPUT'].includes(result.resultType)?targetFromDestination(result.destination,result.kind,inputText):null;const sendWrap=q('[data-send-wrap]');sendWrap.hidden=!target;const send=q('[data-send-result]');if(target){send.textContent=`Open in ${target.toolId.replaceAll('-',' ')} \u2192`;send.onclick=()=>{if(target.state)sessionStorage.setItem('helpdevops.transfer.v1',JSON.stringify({contractVersion:1,source:'universal-input',state:target.state}));location.href=target.path;};}const brief=q('[data-build-incident-brief]');brief.hidden=false;brief.onclick=()=>{sessionStorage.setItem('helpdevops.incident-brief-transfer.v1',JSON.stringify({contractVersion:1,source:'universal-input',expiresAt:Date.now()+300000,data:{summary:result.title,symptom:result.summary,context:`Universal Input \u00b7 ${result.kind}`,observations:layer.observed.join('\n'),unknowns:layer.unknowns.join('\n'),checks:(result.checked||[]).join('\n'),verification:layer.verification.join('\n'),nextStep:layer.checks.join('\n')}}));location.href='/incident-brief/';};const panel=q('[data-analysis-result]');panel.dataset.resultRenderedKind=result.kind||'unknown';panel.hidden=false;panel.focus();};
  document.querySelectorAll('[data-analyzer-root]').forEach(root=>{const input=root.querySelector('[data-analysis-input]'),context=root.querySelector('[data-analysis-context]');root.querySelector('[data-analyze]')?.addEventListener('click',async()=>fill(root,await orchestrateInput(input.value,context?.value||'auto'),input.value));root.querySelectorAll('[data-example]').forEach(button=>button.addEventListener('click',()=>{input.value=button.dataset.example;input.focus()}));root.querySelector('[data-copy-output]')?.addEventListener('click',async()=>navigator.clipboard.writeText(root.querySelector('[data-formatted-output]').textContent));for(const event of ['dragenter','dragover'])input.addEventListener(event,e=>{e.preventDefault();root.dataset.dragActive='true'});for(const event of ['dragleave','drop'])input.addEventListener(event,e=>{e.preventDefault();root.dataset.dragActive='false'});input.addEventListener('drop',e=>{const text=e.dataTransfer?.getData('text/plain');if(text){input.value=text;input.dispatchEvent(new Event('input',{bubbles:true}))}});});
</script>
