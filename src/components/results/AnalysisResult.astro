<section class="analysis-result" data-analysis-result hidden aria-live="polite" tabindex="-1">
  <div class="analysis-head"><div><span class="eyebrow" data-result-kind>ANALYSIS RESULT</span><h2 data-result-title>Result</h2></div><span class="badge" data-result-status>READY</span></div>
  <p class="analysis-summary" data-result-summary></p>
  <div class="analysis-columns">
    <section><h3>Why?</h3><ul data-result-evidence></ul></section>
    <section><h3>What can I do?</h3><ul data-result-actions></ul></section>
    <section><h3>What was checked?</h3><ul data-result-checked></ul></section>
    <section><h3>What was not checked?</h3><ul data-result-not-checked></ul></section>
    <section><h3>What next?</h3><ul data-result-next></ul></section>
  </div>
  <div class="formatted-output" data-formatted-wrap hidden><div class="output-head"><h3>Formatted output</h3><button class="button ghost" type="button" data-copy-output>Copy output</button></div><pre data-formatted-output></pre></div>
</section>
