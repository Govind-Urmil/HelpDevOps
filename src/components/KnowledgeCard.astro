---
// @ts-nocheck
const {item}=Astro.props;
---
<article class="reason-panel knowledge-card" id={item.id} data-knowledge-object={item.id}><span class="eyebrow">{item.family} · {item.action.safety}</span><h3>{item.title}</h3><p>{item.summary}</p><div class="knowledge-priority"><p><strong>What's happening:</strong> {item.assessment.observed}</p><p><strong>Do this first:</strong> {item.investigation.firstStep}</p><div class="diagnostic-command"><span class="command-meta">Read-only</span><code>{item.investigation.commands[0]}</code><button class="command-copy" type="button" aria-label={`Copy read-only command for ${item.title}`} data-copy-command data-command={item.investigation.commands[0]}>⧉</button></div><p><strong>Check this:</strong> {item.action.verification[0]}</p></div><details><summary>Why this result, safety, versions, and sources</summary><p>{item.assessment.confidenceBasis}</p><p><strong>Need more information:</strong> {item.investigation.missingEvidence.join(', ')}</p><p><strong>Recovery:</strong> {item.action.recovery.join(' ')}</p><p><strong>Stop or escalate:</strong> {item.action.stopCriteria.join(' ')}</p><p><strong>Reviewed:</strong> {item.versions} · {item.reviewedAt}</p><p><strong>Known limitation:</strong> {item.knowledge.limitations.join(' ')}</p><a href={item.knowledge.references[0].url} rel="noreferrer">{item.knowledge.references[0].title}</a></details></article>
