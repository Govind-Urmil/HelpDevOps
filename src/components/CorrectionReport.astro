---
import {site} from '../config/site.js';const {resourceId='page'}=Astro.props;const template=`HelpDevOps technical correction\nResource: ${resourceId}\nRelease: ${site.version}\n\nWhat appears incorrect:\n\nSuggested authoritative source:\n\nDo not include logs, credentials, or private operational data.`;
---
<details class="correction-report"><summary>Technical correction template</summary><p>Nothing is sent or attached automatically. Review the template before sharing it through your preferred channel.</p><button class="button ghost" type="button" data-copy-correction data-template={template}>Copy correction template</button><p data-correction-status aria-live="polite"></p></details>
<script>// @ts-nocheck
const reliableCopy=async value=>{let copied=false;try{await navigator.clipboard?.writeText(value);copied=true}catch{}const field=document.createElement('textarea');field.value=value;field.setAttribute('readonly','');field.style.position='fixed';field.style.opacity='0';document.body.append(field);field.select();try{copied=document.execCommand('copy')||copied}catch{}field.remove();return copied};
document.querySelectorAll('[data-copy-correction]').forEach(button=>button.addEventListener('click',async()=>{const status=button.parentElement?.querySelector('[data-correction-status]');const copied=await reliableCopy(button.dataset.template||'');if(status)status.textContent=copied?'Correction template copied. Review it before sharing.':'Copy unavailable. Select the template manually; nothing was sent.'}));</script>
