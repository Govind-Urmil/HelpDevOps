---
import SearchInput from './SearchInput.astro';import SearchResult from './SearchResult.astro';
---
<dialog class="search-dialog" data-search-dialog aria-labelledby="search-title">
  <div class="dialog-head"><div><span class="eyebrow">UNIFIED SEARCH</span><h2 id="search-title">Find your next action</h2></div><button type="button" data-search-close aria-label="Close search">×</button></div>
  <SearchInput/><SearchResult/>
  <p class="dialog-help"><kbd>Esc</kbd> close <span>·</span> Input stays in this browser tab.</p>
</dialog>
