---
const {tool}=Astro.props;
---
<article class="card tool-card"><div class="tool-card-head"><span class="capability">{tool.capabilities.join(' · ')}</span><span class:list={['badge',tool.status==='planned'&&'warning']}>{tool.status.toUpperCase()}</span></div><h2>{tool.title}</h2><p>{tool.description}</p>{tool.status==='available'?<a class="button secondary" href={tool.path}>Open tool →</a>:<span class="muted">Planned capability</span>}</article>
