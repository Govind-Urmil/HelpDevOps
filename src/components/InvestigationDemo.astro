<aside class="investigation-demo" aria-labelledby="demo-title" data-investigation-demo>
  <div class="demo-window-bar"><span class="demo-status"><i aria-hidden="true"></i> Interactive example</span><span data-demo-count>1 / 4</span></div>
  <div class="demo-content" aria-live="off">
    <p class="eyebrow" data-demo-domain>KUBERNETES</p><h2 id="demo-title" data-demo-title>Pod remains Pending</h2>
    <ol class="demo-flow">
      <li><span>01</span><div><strong>Observed symptom</strong><p data-demo-symptom>Workload has not scheduled.</p></div></li>
      <li><span>02</span><div><strong>Evidence</strong><p data-demo-evidence>Scheduler event reports insufficient memory.</p></div></li>
      <li><span>03</span><div><strong>Safe branch</strong><p data-demo-branch>Compare requests with allocatable capacity.</p></div></li>
      <li><span>04</span><div><strong>Verification</strong><p data-demo-verify>Pod schedules and reaches Ready.</p></div></li>
    </ol>
    <div class="demo-outcome"><span>RECOVERY CHECK</span><strong data-demo-outcome>Placement confirmed without a blind change</strong></div>
  </div>
</aside>
<script>
  // @ts-nocheck
  const demos=[
    {domain:'KUBERNETES',title:'Pod remains Pending',symptom:'Workload has not scheduled.',evidence:'Scheduler event reports insufficient memory.',branch:'Compare requests with allocatable capacity.',verify:'Pod schedules and reaches Ready.',outcome:'Placement confirmed without a blind change'},
    {domain:'HTTP',title:'Upstream returns 502',symptom:'Gateway cannot complete the request.',evidence:'Direct upstream health check fails.',branch:'Separate service health from gateway routing.',verify:'Upstream and gateway checks both return 2xx.',outcome:'Request path verified end to end'},
    {domain:'LINUX',title:'Disk usage reaches 100%',symptom:'Writes fail with no space left.',evidence:'One filesystem and log path account for growth.',branch:'Preserve evidence before reversible cleanup.',verify:'Free space is stable and writes succeed.',outcome:'Capacity recovered with cause recorded'},
    {domain:'TERRAFORM',title:'State lock blocks apply',symptom:'A lock prevents the planned operation.',evidence:'Lock owner and active run are identified.',branch:'Confirm the owner before considering unlock.',verify:'Plan runs and state remains consistent.',outcome:'Lock cleared without state corruption'}
  ];
  document.querySelectorAll('[data-investigation-demo]').forEach(root=>{
    if(root.dataset.ready)return;root.dataset.ready='true';const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;let index=0,timer,visible=true;
    const set=(selector,value)=>{const node=root.querySelector(selector);if(node)node.textContent=value};
    const render=()=>{const item=demos[index];root.dataset.transitioning='true';setTimeout(()=>{set('[data-demo-domain]',item.domain);set('[data-demo-title]',item.title);set('[data-demo-symptom]',item.symptom);set('[data-demo-evidence]',item.evidence);set('[data-demo-branch]',item.branch);set('[data-demo-verify]',item.verify);set('[data-demo-outcome]',item.outcome);set('[data-demo-count]',`${index+1} / ${demos.length}`);root.dataset.transitioning='false'},reduce?0:180)};
    const stop=()=>{if(timer)clearInterval(timer)};const start=()=>{stop();if(!reduce&&visible)timer=setInterval(()=>{index=(index+1)%demos.length;render()},7000)};
    if('IntersectionObserver'in window)new IntersectionObserver(entries=>{visible=entries[0]?.isIntersecting??true;visible?start():stop()},{threshold:.15}).observe(root);
    document.addEventListener('visibilitychange',()=>document.hidden?stop():start());start();
  });
</script>
