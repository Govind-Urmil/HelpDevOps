---
import BaseLayout from '../layouts/BaseLayout.astro';import PageHeader from '../components/PageHeader.astro';import {pageMetadata as m} from '../config/pages.js';
const fields=[['summary','Incident or problem summary'],['symptom','Observed symptom'],['context','Execution context'],['observations','Structured observations'],['unknowns','What remains unknown'],['checks','Checks completed'],['actions','Actions considered or taken'],['riskNotes','Risk notes'],['verification','Current verification state'],['nextStep','Recommended next step'],['escalationQuestions','Escalation questions'],['rawEvidence','Raw evidence']];
---
<BaseLayout {...m.incidentBrief} breadcrumbs={[{label:'Home',href:'/'},{label:'Workspace',href:'/workspace/'},{label:'Incident Brief',href:'/incident-brief/'}]}>
  <PageHeader eyebrow="LOCAL HANDOVER · EXPLICIT EXPORT" title="Build an Incident Brief" description="Summarize an investigation for continuation or handover. Nothing is uploaded or saved automatically." />
  <section class="section"><div class="container brief-layout"><form class="workspace-panel" data-brief-form><fieldset><legend>Privacy mode</legend><label><input type="radio" name="brief-mode" value="summary" checked/> Summary only (recommended)</label><label><input type="radio" name="brief-mode" value="structured"/> Include structured observations</label><label><input type="radio" name="brief-mode" value="raw"/> Include raw evidence after review</label></fieldset>{fields.map(([name,label])=><label data-brief-field={name}>{label}<textarea name={name} rows={name==='rawEvidence'?8:3}></textarea></label>)}<label data-raw-ack hidden><input type="checkbox" name="rawAcknowledged"/> I reviewed this evidence and accept the detected disclosure risk.</label><div class="tool-actions"><button class="button primary" type="submit">Generate brief</button><button class="button secondary" type="button" data-brief-copy>Copy</button><button class="button ghost" type="button" data-brief-download>Download Markdown</button></div><p data-brief-status aria-live="polite">Draft stays in memory until you explicitly copy or download it.</p></form><aside class="workspace-panel"><h2>Preview</h2><pre data-brief-preview>No brief generated.</pre><h3>Privacy boundaries</h3><ul><li>Raw evidence is excluded by default.</li><li>Private-key-like material is always blocked.</li><li>Warnings are detection aids, not encryption.</li><li>Review downloaded content before sharing.</li></ul></aside></div></section>
</BaseLayout>
<script>
 // @ts-nocheck
 import {createIncidentBrief,briefToMarkdown,safeBriefFilename} from '../incident-brief/brief.js';
 const form=document.querySelector('[data-brief-form]'),preview=document.querySelector('[data-brief-preview]'),status=document.querySelector('[data-brief-status]');let output='';const transferKey='helpdevops.incident-brief-transfer.v1';
 const mode=()=>form.querySelector('[name="brief-mode"]:checked').value;const sync=()=>{const raw=mode()==='raw',structured=raw||mode()==='structured';form.querySelector('[data-brief-field="rawEvidence"]').hidden=!raw;form.querySelector('[data-raw-ack]').hidden=!raw;form.querySelector('[data-brief-field="observations"]').hidden=!structured;};
 form.querySelectorAll('[name="brief-mode"]').forEach(input=>input.addEventListener('change',sync));sync();const applyTransfer=()=>{let transfer=null;try{transfer=JSON.parse(sessionStorage.getItem(transferKey)||'null')}catch{}sessionStorage.removeItem(transferKey);if(!transfer||transfer.contractVersion!==1||!transfer.data||transfer.expiresAt<Date.now()){if(transfer)status.textContent='Transferred investigation context was stale or incompatible and was not applied.';return;}for(const [key,value] of Object.entries(transfer.data)){const control=form.elements[key];if(control&&typeof value==='string')control.value=value;}form.elements.rawEvidence.value='';form.querySelector('[name="brief-mode"][value="structured"]').checked=true;sync();status.textContent=`Structured context transferred from ${transfer.source}. Review and edit it before generating; transferred content is not newly verified.`;};applyTransfer();
 form.addEventListener('submit',event=>{event.preventDefault();try{const data=Object.fromEntries(new FormData(form));const brief=createIncidentBrief(data,mode(),data.rawAcknowledged==='on');output=briefToMarkdown(brief);preview.textContent=output;status.textContent=brief.sensitivity.warnings.length?`Brief generated locally with ${brief.sensitivity.warnings.length} disclosure warning(s). Review before sharing.`:'Brief generated locally. Review before sharing.';}catch(error){output='';preview.textContent='No brief generated.';status.textContent=error.message;}});
 form.querySelector('[data-brief-copy]').addEventListener('click',async()=>{if(!output)return status.textContent='Generate a brief first.';try{await navigator.clipboard.writeText(output);status.textContent='Brief copied locally.'}catch{status.textContent='Copy unavailable; select the preview manually.'}});
 form.querySelector('[data-brief-download]').addEventListener('click',()=>{if(!output)return status.textContent='Generate a brief first.';let url;try{const summary=form.elements.summary.value;url=URL.createObjectURL(new Blob([output],{type:'text/markdown;charset=utf-8'}));const link=document.createElement('a');link.href=url;link.download=safeBriefFilename(summary);link.rel='noopener';link.hidden=true;document.body.append(link);link.click();link.remove();setTimeout(()=>URL.revokeObjectURL(url),60000);status.textContent='Markdown download requested. Check your browser downloads.'}catch{if(url)URL.revokeObjectURL(url);status.textContent='The Markdown download could not be started.'}});
</script>
