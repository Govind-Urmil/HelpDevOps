---
import StatusPage from '../components/StatusPage.astro'; import {pageMetadata as m} from '../config/pages.js';
const sections=[{label:'PREVIEW',title:'Continuity without an account',text:'The Session Dock and send-to data contracts are ready for future browser-local handoffs. EP-002 does not persist user content.'},{label:'ZERO DEAD ENDS',title:'One result can lead to the next action',text:'Future results can recommend a related tool, troubleshooting path, guide, or reference while keeping the reason for that suggestion visible.'},{label:'PRIVACY',title:'Local state must stay understandable',text:'When persistence is introduced, the interface will disclose what is saved, where it lives, and how to clear it.',link:{href:'/privacy/',label:'Read the privacy approach'}}];
---
<StatusPage meta={m.workspace} eyebrow="WORKSPACE · PREVIEW" title="Workspace" description="A future local workspace for keeping related DevOps tasks together without forcing cloud sync or an account." status="Preview" sections={sections}/>
