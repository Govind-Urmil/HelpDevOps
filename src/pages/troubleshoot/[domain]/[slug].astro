---
// @ts-nocheck
import BaseLayout from '../../../layouts/BaseLayout.astro';import PageHeader from '../../../components/PageHeader.astro';import ProvenanceStrip from '../../../components/ProvenanceStrip.astro';import DiagnosticJourney from '../../../components/diagnostics/DiagnosticJourney.astro';import {publishedJourneys} from '../../../diagnostics/registry.js';import {referencesForJourney} from '../../../references/relations.js';
export function getStaticPaths(){return publishedJourneys.map(journey=>({params:{domain:journey.domain,slug:journey.slug},props:{journey}}))}
const {journey}=Astro.props;const relatedReferences=referencesForJourney(journey.id);const meta={path:journey.path,title:`${journey.title} | HelpDevOps`,description:journey.summary};
---
<BaseLayout {...meta} breadcrumbs={[{label:'Home',href:'/'},{label:'Troubleshoot',href:'/troubleshoot/'},{label:journey.domain,href:`/troubleshoot/${journey.domain}/`},{label:journey.title,href:journey.path}]}>
<PageHeader eyebrow={`${journey.domain.toUpperCase()} · ${journey.status === 'reviewed' ? 'REVIEWED DIAGNOSTIC' : 'TECHNICAL REVIEW CANDIDATE'}`} title={journey.title} description={journey.summary}/><div class="container"><ProvenanceStrip status={journey.status} reviewedAt={journey.reviewedAt} compatibility={`${journey.compatibility.technology}: ${journey.compatibility.reviewedAgainst?.join(', ') || 'general guidance'}`} sourcesHref="#authoritative-sources" limitationsHref="#limitations" /></div>
<section class="section"><div class="container"><DiagnosticJourney {journey}/><aside class="reference-panel" id="authoritative-sources"><h2>Authoritative references</h2><ul>{journey.references.map(ref=><li><a href={ref.url} rel="noreferrer">{ref.title}</a></li>)}</ul><h3>First safe checks</h3><ul>{journey.firstChecks.map(item=><li><code>{item}</code></li>)}</ul>{relatedReferences.length>0&&<section class="related-reference-panel"><h2>Understand the evidence</h2><div class="tool-grid">{relatedReferences.map(ref=><article class="tool-card"><span class="eyebrow">REFERENCE</span><h3><a href={ref.path}>{ref.title}</a></h3><p>{ref.summary}</p></article>)}</div></section>}</aside></div></section>
</BaseLayout>
