---
// @ts-nocheck
import BaseLayout from '../../layouts/BaseLayout.astro';import PageHeader from '../../components/PageHeader.astro';import {publishedJourneys,diagnosticDomains} from '../../diagnostics/registry.js';import {guidedCoverageStartingPoints} from '../../investigations/coverage.js';import {prioritizeJourneysForRole,resolveRole,roleProfiles} from '../../investigations/experience.js';import {symptomStarts} from '../../investigations/symptoms.js';
const selectedRole=resolveRole(Astro.url.searchParams.get('role'));const roleProfile=roleProfiles[selectedRole];const orderedJourneys=prioritizeJourneysForRole(publishedJourneys,selectedRole);const meta={path:'/troubleshoot/',title:`${publishedJourneys.length} DevOps Troubleshooting Journeys | HelpDevOps`,description:'Evidence-first diagnostic journeys for Linux, Docker, Kubernetes, Terraform, Git, Jenkins, Cron, networking, Bash, and YAML errors.'};
---
<BaseLayout {...meta} breadcrumbs={[{label:'Home',href:'/'},{label:'Troubleshoot',href:'/troubleshoot/'}]}>
<PageHeader eyebrow={`DIAGNOSTIC PLATFORM · ${publishedJourneys.length} JOURNEYS`} title="Find the safest next check" description="Start with a symptom, collect minimum useful evidence, branch on observations, and verify recovery without sending input to a server." />
<section class="section"><div class="container"><aside class="investigation-panel" data-role-profile><span class="eyebrow">ROLE-BASED START</span><h2>{roleProfile.label}</h2><p>{roleProfile.recommendation}</p><p><strong>Suggested tools:</strong> {roleProfile.tools.join(", ")} · <strong>Suggested references:</strong> {roleProfile.references.join(", ")}</p><a class="button secondary" href={orderedJourneys[0].path}>Start with {orderedJourneys[0].title}</a></aside><div class="diagnostic-hubs">{diagnosticDomains.map(domain=><a class="quick-card" href={`/troubleshoot/${domain}/`}><h2>{domain[0].toUpperCase()+domain.slice(1)} troubleshooting</h2><p>{publishedJourneys.filter(item=>item.domain===domain).length} guided journeys</p></a>)}</div><div class="index-filter"><label for="journey-filter">Filter by symptom, exact error, output fragment, exit code, or technology</label><input id="journey-filter" type="search" placeholder="Try ImagePullBackOff, exit code 137, HTTP 502, Terraform, or disk full" data-journey-filter/><p data-filter-status>{publishedJourneys.length} journeys available</p></div><section class="coverage-starts" aria-labelledby="symptom-directory-title"><div class="section-heading"><div><span class="eyebrow">SYMPTOM-FIRST</span><h2 id="symptom-directory-title">Choose the failure you can observe</h2><p>These starts route directly to evidence-first investigations.</p></div></div><div class="symptom-grid">{symptomStarts.map(item=><a class="card symptom-card" href={item.href} data-search={`${item.title} ${item.signal}`.toLowerCase()}><span class="symptom-signal">{item.signal}</span><h3>{item.title}</h3><p>{item.firstEvidence}</p></a>)}</div></section><section class="coverage-starts" aria-labelledby="coverage-starts-title"><div class="section-heading"><div><span class="eyebrow">MORE OPERATIONAL STARTS</span><h2 id="coverage-starts-title">Start from the affected responsibility area</h2><p>These bounded entry points reuse existing guidance. They do not claim vendor-specific diagnosis.</p></div></div><div class="tool-grid">{guidedCoverageStartingPoints.map(item=><article class="tool-card" data-search={`${item.title} ${item.summary} ${item.search.join(' ')}`.toLowerCase()}><span class="eyebrow">GUIDED START</span><h3><a href={item.href}>{item.title}</a></h3><p>{item.summary}</p><h4>Evidence to collect</h4><ul>{item.evidence.map(step=><li>{step}</li>)}</ul><details><summary>Safe prerequisites</summary><ul>{item.prerequisites.map(step=><li>{step}</li>)}</ul></details><a class="button secondary" href={item.href}>{item.nextStepLabel}</a></article>)}</div></section><div class="tool-grid" data-journey-grid>{orderedJourneys.map(journey=><article class="tool-card" data-search={`${journey.title} ${journey.summary} ${journey.domain} ${journey.aliases.join(' ')} ${journey.exactErrors.join(' ')}`.toLowerCase()}><span class="eyebrow">{journey.status === 'reviewed' ? 'Reviewed guidance' : 'Guidance with stated limitations'}</span><h2><a href={journey.path}>{journey.title}</a></h2><p>{journey.summary}</p><div class="journey-meta"><span>{journey.nodes.length} decision nodes</span><span>~{Math.max(5,Math.ceil(journey.nodes.length*1.4))} min</span><span>{journey.riskProfile.replaceAll("-", " ")}</span></div><a class="button secondary" href={journey.path}>Start investigation</a></article>)}</div></div></section>
<script>
// @ts-nocheck
const input=document.querySelector('[data-journey-filter]'),cards=[...document.querySelectorAll('[data-search]')],status=document.querySelector('[data-filter-status]');input?.addEventListener('input',()=>{const terms=input.value.toLowerCase().trim().split(/\s+/).filter(Boolean);let count=0;for(const card of cards){const match=terms.every(term=>card.dataset.search.includes(term));card.hidden=!match;if(match)count++}status.textContent=`${count} ${count===1?'journey':'journeys'} shown`});</script>
</BaseLayout>

