---
import BaseLayout from '../../layouts/BaseLayout.astro';import PageHeader from '../../components/PageHeader.astro';import {publishedJourneys,diagnosticDomains} from '../../diagnostics/registry.js';
const meta={path:'/troubleshoot/',title:'30 DevOps Troubleshooting Journeys | HelpDevOps',description:'Evidence-first diagnostic journeys for Linux, Docker, Kubernetes, Terraform, Git, Jenkins, Cron, networking, Bash, and YAML errors.'};
---
<BaseLayout {...meta} breadcrumbs={[{label:'Home',href:'/'},{label:'Troubleshoot',href:'/troubleshoot/'}]}>
<PageHeader eyebrow="DIAGNOSTIC PLATFORM · 30 JOURNEYS" title="Find the safest next check" description="Start with a symptom, collect minimum useful evidence, branch on observations, and verify recovery without sending input to a server." />
<section class="section"><div class="container"><div class="diagnostic-hubs">{diagnosticDomains.map(domain=><a class="quick-card" href={`/troubleshoot/${domain}/`}><h2>{domain[0].toUpperCase()+domain.slice(1)} troubleshooting</h2><p>{publishedJourneys.filter(item=>item.domain===domain).length} guided journeys</p></a>)}</div><div class="index-filter"><label for="journey-filter">Filter by symptom, error, or technology</label><input id="journey-filter" type="search" placeholder="Try ImagePullBackOff, timeout, Git, or disk full" data-journey-filter/><p data-filter-status>{publishedJourneys.length} journeys available</p></div><div class="tool-grid" data-journey-grid>{publishedJourneys.map(journey=><article class="tool-card" data-search={`${journey.title} ${journey.summary} ${journey.domain} ${journey.aliases.join(' ')} ${journey.exactErrors.join(' ')}`.toLowerCase()}><span class="eyebrow">{journey.status === 'reviewed' ? 'reviewed' : 'technical review'}</span><h2><a href={journey.path}>{journey.title}</a></h2><p>{journey.summary}</p><a class="button secondary" href={journey.path}>Start diagnosis</a></article>)}</div></div></section>
<script>
// @ts-nocheck
const input=document.querySelector('[data-journey-filter]'),cards=[...document.querySelectorAll('[data-search]')],status=document.querySelector('[data-filter-status]');input?.addEventListener('input',()=>{const terms=input.value.toLowerCase().trim().split(/\s+/).filter(Boolean);let count=0;for(const card of cards){const match=terms.every(term=>card.dataset.search.includes(term));card.hidden=!match;if(match)count++}status.textContent=`${count} ${count===1?'journey':'journeys'} shown`});</script>
</BaseLayout>

