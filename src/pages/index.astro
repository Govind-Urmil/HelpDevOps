---
import BaseLayout from '../layouts/BaseLayout.astro';import UniversalInput from '../components/UniversalInput.astro';import TechnologyMark from '../components/TechnologyMark.astro';import {pageMetadata as meta} from '../config/pages.js';import {roleStartingPoints} from '../investigations/experience.js';import {symptomStarts} from '../investigations/symptoms.js';
const featured=[['docker','Dockerfile and Compose checks','/tools/'],['kubernetes','Kubernetes manifest checks','/tools/kubernetes-manifest/'],['linux','Linux permissions','/tools/linux-permissions/'],['git','Git reference toolkit','/tools/git-reference/']];
---
<BaseLayout {...meta.home}>
<section class="hero"><div class="container"><div class="hero-copy"><span class="eyebrow">LOCAL · DETERMINISTIC · EVIDENCE-FIRST</span><h1>Find the safest next step<br/><span>when DevOps breaks.</span></h1><p>HelpDevOps turns supported errors, command output, and configuration into transparent checks and guided troubleshooting. Analysis stays in your browser, and every result states its limits.</p><div class="tool-actions"><a class="button primary" href="#analyze">Analyze something</a><a class="button secondary" href="/troubleshoot/">Browse 37 diagnostic journeys</a></div></div><div id="analyze"><UniversalInput /></div></div></section>
<section class="section symptom-starts" aria-labelledby="symptom-start-title"><div class="container"><div class="section-heading"><div><span class="eyebrow">START FROM THE SYMPTOM</span><h2 id="symptom-start-title">What is failing right now?</h2><p>Choose the closest observed symptom. Each path begins with evidence collection, not a guessed cause.</p></div></div><div class="symptom-grid">{symptomStarts.map(item=><a class="card symptom-card" href={item.href}><span class="symptom-signal">{item.signal}</span><h3>{item.title}</h3><p>{item.firstEvidence}</p><span class="card-action">Start with evidence →</span></a>)}</div></div></section>
<section class="section role-starts" aria-labelledby="role-start-title"><div class="container"><div class="section-heading"><div><span class="eyebrow">CHOOSE YOUR START</span><h2 id="role-start-title">What kind of help do you need?</h2><p>Use the same reviewed resources with a starting point matched to your immediate goal.</p></div></div><div class="role-start-grid">{roleStartingPoints.map(role=><a class="card role-start-card" href={role.href} data-role-start={role.id}><h3>{role.label}</h3><p>{role.description}</p><span>Start here →</span></a>)}</div></div></section>
<section class="section"><div class="container"><div class="section-heading"><div><span class="eyebrow">TROUBLESHOOT</span><h2>Move from symptom to verified recovery</h2><p>Choose a reviewed path, collect read-only evidence, branch on what you observe, and keep rollback and verification visible.</p></div><a class="button secondary" href="/troubleshoot/">Find a diagnostic journey</a></div><div class="quick-grid"><a class="card quick-card" href="/troubleshoot/linux/"><TechnologyMark technology="linux"/><h3>Host and service issues</h3><p>Disk, memory, permissions, systemd, and shell execution.</p></a><a class="card quick-card" href="/troubleshoot/docker/"><TechnologyMark technology="docker"/><h3>Container issues</h3><p>Builds, exits, storage, and container networking.</p></a><a class="card quick-card" href="/troubleshoot/kubernetes/"><TechnologyMark technology="kubernetes"/><h3>Cluster workload issues</h3><p>Scheduling, crashes, image pulls, memory, and Services.</p></a></div></div></section>
<section class="section"><div class="container"><div class="section-heading"><div><span class="eyebrow">FEATURED TOOLS</span><h2>Check evidence without sending it away</h2></div><a href="/tools/">View all tools →</a></div><div class="tool-grid">{featured.map(([technology,title,path])=><a class="tool-card" href={path}><TechnologyMark technology={technology}/><h3>{title}</h3><p>Deterministic browser-local analysis with visible evidence and limitations.</p></a>)}</div></div></section>
<section class="section"><div class="container two-col"><article class="preflight-card"><span class="eyebrow">WHY TRUST IT</span><h2>Evidence before certainty</h2><ul><li>Nothing is uploaded or saved automatically.</li><li>Recognition is deterministic—no AI-generated diagnosis.</li><li>Guidance links to official sources and includes rollback, verification, and prevention.</li></ul><a href="/about/">How HelpDevOps works →</a></article><article class="workspace-card"><span class="eyebrow">CONTINUE LOCALLY</span><h2>Keep the investigation coherent</h2><p>Explicitly save supported state or build a privacy-controlled Incident Brief for verification and handover.</p><div class="tool-actions"><button class="button ghost" type="button" data-session-open>Open Session Dock</button><a class="button secondary" href="/incident-brief/">Build Incident Brief</a></div></article></div></section>
</BaseLayout>
