---
import BaseLayout from '../layouts/BaseLayout.astro';
import UniversalInput from '../components/UniversalInput.astro';
import HeroNetwork from '../components/HeroNetwork.astro';
import {pageMetadata as meta} from '../config/pages.js';
import {symptomStarts} from '../investigations/symptoms.js';
import {publishedJourneys} from '../diagnostics/registry.js';
const homeMeta={...meta.home,description:`Diagnose supported DevOps issues with private browser-first tools and ${publishedJourneys.length} guided diagnostic journeys.`};
---
<BaseLayout {...homeMeta}>
  <section class="hero ep021-hero"><div class="container">
    <div class="ep021-hero-grid">
      <div class="hero-copy"><span class="eyebrow">OBSERVE · INVESTIGATE · VERIFY · RECOVER</span><h1>Find the safest next step <span>when DevOps breaks.</span></h1><p>Analyze supported evidence locally, follow transparent branches, and verify recovery without guessing.</p><div class="tool-actions"><a class="button primary" href="#analyze">Analyze Evidence</a><a class="button secondary" href="/troubleshoot/">Browse Investigations</a></div></div>
      <HeroNetwork />
    </div>
    <div id="analyze" class="hero-analyzer"><UniversalInput /></div>
  </div></section>
  <section id="symptoms" class="section symptom-starts" aria-labelledby="symptom-start-title"><div class="container"><div class="section-heading"><div><span class="eyebrow">START FROM THE SYMPTOM</span><h2 id="symptom-start-title">What is failing right now?</h2><p>Choose what you observed. The journey starts with evidence, not a guessed cause.</p></div></div><div class="symptom-grid">{symptomStarts.slice(0,6).map(item=><a class="card symptom-card" href={item.href}><span class="symptom-signal">{item.signal}</span><h3>{item.title}</h3><p>{item.firstEvidence}</p><span class="card-action">Start investigation →</span></a>)}</div></div></section>
  <section class="section platform-paths" aria-labelledby="platform-paths-title"><div class="container"><div class="section-heading"><div><span class="eyebrow">BROWSE THE PLATFORM</span><h2 id="platform-paths-title">Go deeper when you know the route</h2></div></div><div class="platform-path-grid"><a class="platform-path" href="/troubleshoot/"><span>01</span><div><h3>Investigations</h3><p>Reviewed, branching paths from symptom to verified recovery.</p></div><strong>Browse journeys →</strong></a><a class="platform-path" href="/tools/"><span>02</span><div><h3>Tools</h3><p>Deterministic checks for supported evidence and configuration.</p></div><strong>Browse tools →</strong></a></div></div></section>
</BaseLayout>
