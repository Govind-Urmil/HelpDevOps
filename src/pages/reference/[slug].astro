---
// @ts-nocheck
import BaseLayout from '../../layouts/BaseLayout.astro';import PageHeader from '../../components/PageHeader.astro';import {publishedReferences} from '../../references/registry.js';import {relatedForReference} from '../../references/relations.js';
export function getStaticPaths(){return publishedReferences.map(reference=>({params:{slug:reference.id},props:{reference}}))}
const {reference}=Astro.props;const related=relatedForReference(reference);const meta={path:reference.path,title:`${reference.title} | HelpDevOps`,description:reference.summary};
---
<BaseLayout {...meta} breadcrumbs={[{label:'Home',href:'/'},{label:'References',href:'/reference/'},{label:reference.title,href:reference.path}]}><PageHeader eyebrow={`${reference.domain.toUpperCase()} · REVIEWED REFERENCE`} title={reference.title} description={reference.summary}/><section class="section"><div class="container reference-layout"><article class="reference-body"><section><h2>Key distinctions</h2>{reference.concepts.map(c=><div class="reason-panel"><h3>{c.title}</h3><p>{c.explanation}</p></div>)}</section><section><h2>What this does not prove</h2><ul>{reference.limitations.map(x=><li>{x}</li>)}</ul></section><section><h2>Common use</h2>{reference.examples.map(x=><div><h3>{x.title}</h3><p>{x.text}</p></div>)}</section><section><h2>Official references</h2><ul>{reference.references.map(x=><li><a href={x.url} rel="noreferrer">{x.title}</a></li>)}</ul></section></article><aside class="reference-panel"><span class="eyebrow">REVIEWED {reference.reviewedAt}</span><h2>Continue with HelpDevOps</h2>{related.length?<ul>{related.map(x=><li><a href={x.path}><strong>{x.title}</strong></a><br/><span class="muted">{x.type} · {x.summary}</span></li>)}</ul>:<p class="muted">No related operational destination is currently published.</p>}<p><a href="/errors/">Browse error and symptom index</a></p></aside></div></section></BaseLayout>
