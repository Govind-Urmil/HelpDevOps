---
import BaseLayout from '../../layouts/BaseLayout.astro';import PageHeader from '../../components/PageHeader.astro';import {publishedReferences,referenceDomains} from '../../references/registry.js';
const meta={path:'/reference/',title:'DevOps Operational References | HelpDevOps',description:'Reviewed, concise DevOps references that explain operational states, evidence, limits, and the safest next troubleshooting destination.'};
---
<BaseLayout {...meta} breadcrumbs={[{label:'Home',href:'/'},{label:'References',href:'/reference/'}]}><PageHeader eyebrow="OPERATIONAL REFERENCE LIBRARY" title="Understand the evidence before acting" description="Compact, reviewed references connect operational concepts to the right diagnostic journey, interpreter, or tool."/><section class="section"><div class="container"><div class="filter-row" aria-label="Reference domains">{referenceDomains.map(d=><a class="badge" href={`#${d}`}>{d}</a>)}</div>{referenceDomains.map(domain=><section id={domain} class="reference-group"><h2>{domain[0].toUpperCase()+domain.slice(1)}</h2><div class="tool-grid">{publishedReferences.filter(r=>r.domain===domain).map(r=><article class="tool-card"><span class="eyebrow">REFERENCE · {r.status}</span><h3><a href={r.path}>{r.title}</a></h3><p>{r.summary}</p><a class="button secondary" href={r.path}>Open reference</a></article>)}</div></section>)}</div></section></BaseLayout>
