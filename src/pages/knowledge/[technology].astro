---
// @ts-nocheck
import BaseLayout from '../../layouts/BaseLayout.astro';import PageHeader from '../../components/PageHeader.astro';import TechnologyMark from '../../components/TechnologyMark.astro';import KnowledgeCard from '../../components/KnowledgeCard.astro';import {coverageSummary} from '../../operational-knowledge/coverage.js';import {knowledgeObjects} from '../../resources/operational-knowledge/catalog.js';import {technologyLabel} from '../../operational-knowledge/model.js';export function getStaticPaths(){return coverageSummary.map(summary=>({params:{technology:summary.technology},props:{summary,items:knowledgeObjects.filter(item=>item.technology===summary.technology)}}))}const {summary,items}=Astro.props;const label=technologyLabel(summary.technology);const meta={path:`/knowledge/${summary.technology}/`,title:`${label} Operational Knowledge | HelpDevOps`,description:`Reviewed ${label} operational issue knowledge with deterministic evidence and safety boundaries.`};
---
<BaseLayout {...meta} breadcrumbs={[{label:'Home',href:'/'},{label:'Operational knowledge',href:'/knowledge/'},{label,href:meta.path}]}><PageHeader eyebrow={`${label.toUpperCase()} · REVIEWED KNOWLEDGE`} title={`${label} operational issue guidance`} description={`${summary.issueFamilies} reviewed issue families backed by ${summary.fixtures} positive, exclusion, and ambiguity fixtures.`}/><section class="section"><div class="container"><TechnologyMark technology={summary.technology}/><div class="error-index">{items.map(item=><KnowledgeCard item={item}/>)}</div></div></section><script>// @ts-nocheck
document.querySelectorAll('[data-copy-command]').forEach(button=>button.addEventListener('click',async()=>{await navigator.clipboard.writeText(button.dataset.command||'');button.dataset.copied='true';button.setAttribute('aria-label','Copied read-only command')}));</script></BaseLayout>
