---
import BaseLayout from '../../layouts/BaseLayout.astro';import PageHeader from '../../components/PageHeader.astro';import TechnologyMark from '../../components/TechnologyMark.astro';import {coverageSummary} from '../../operational-knowledge/coverage.js';import {technologyLabel} from '../../operational-knowledge/model.js';const meta={path:'/knowledge/',title:'Operational Knowledge | HelpDevOps',description:'Browse deterministic, reviewed operational issue knowledge with evidence and safety boundaries.'};
---
<BaseLayout {...meta} breadcrumbs={[{label:'Home',href:'/'},{label:'Operational knowledge',href:'/knowledge/'}]}><PageHeader eyebrow="OPERATIONAL KNOWLEDGE · REVIEWED" title="Evidence-backed issue knowledge" description="Choose a supported technology. Guidance starts with read-only evidence, states what remains unknown, and links to official sources."/><section class="section"><div class="container tool-grid">{coverageSummary.map(summary=><article class="card tool-card"><TechnologyMark technology={summary.technology}/><h2>{technologyLabel(summary.technology)}</h2><p>{summary.issueFamilies} reviewed issue families · {summary.fixtures} validation fixtures</p><a class="button secondary" href={`/knowledge/${summary.technology}/`}>Browse guidance →</a></article>)}</div></section></BaseLayout>
