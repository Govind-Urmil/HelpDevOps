---
import StatusPage from '../components/StatusPage.astro'; import {pageMetadata as m} from '../config/pages.js';
const sections=[{label:'CURRENT BEHAVIOR',title:'Supported analysis runs locally',text:'Supported tool input is analyzed in this browser tab. Pasted input is not uploaded, transmitted, logged, or persisted, and commands are never executed.'},{label:'CURRENT LIMITS',title:'Classification is not product validation',text:'Compose and Kubernetes signals are classification-only. Detailed schemas, clusters, files, environment interpolation, and runtime behavior are not checked.'},{label:'YOUR INPUT',title:'Treat secrets as secrets',text:'Do not paste credentials or production secrets unless the tool behavior and limits are understood. Local processing reduces transfer risk but does not remove your responsibility for secret handling.'}];
---
<StatusPage meta={m.privacy} eyebrow="PRIVACY" title="Private by design, precise in wording" description="Privacy claims must always match the behavior users can verify." sections={sections}/>
