---
import BaseLayout from '../../layouts/BaseLayout.astro';import PageHeader from '../../components/PageHeader.astro';import {errorEntries} from '../../references/discovery.js';
const domains=[...new Set(errorEntries.map(e=>e.domain))].sort();const meta={path:'/errors/',title:'DevOps Error and Symptom Index | HelpDevOps',description:'Browse reviewed DevOps errors and symptoms by domain, understand what they do not prove, and open the safest next diagnostic path.'};
---
<BaseLayout {...meta} breadcrumbs={[{label:'Home',href:'/'},{label:'Errors',href:'/errors/'}]}><PageHeader eyebrow="REVIEWED DISCOVERY INDEX" title="Errors and symptoms, connected to the next safe step" description="This index routes reviewed signals to diagnostic journeys. Matching a phrase is not a root-cause diagnosis."/><section class="section"><div class="container" data-error-index><div class="index-filter"><label for="error-filter">Filter errors and symptoms</label><input id="error-filter" type="search" placeholder="Try “permission denied”, Docker, DNS…" autocomplete="off" data-error-filter/><p class="muted" data-error-count aria-live="polite">Showing all {errorEntries.length} reviewed signals.</p></div>{domains.map(domain=><section class="reference-group" id={domain} data-error-group><h2>{domain[0].toUpperCase()+domain.slice(1)}</h2><div class="error-index">{errorEntries.filter(e=>e.domain===domain).map(e=><article class="reason-panel" data-error-entry data-search={`${domain} ${e.kind} ${e.term} ${e.summary} ${e.title}`.toLowerCase()}><span class="eyebrow">{e.kind.replace('-',' ')}</span><h3>{e.term}</h3><p>{e.summary}</p><p><strong>Does not prove:</strong> {e.doesNotProve}</p><a href={e.route} aria-label={`Open ${e.title} for “${e.term}”`}>Open diagnostic path <span aria-hidden="true">→</span></a></article>)}</div></section>)}</div></section></BaseLayout>
<script>
  // @ts-nocheck
  const root=document.querySelector('[data-error-index]');
  const input=root?.querySelector('[data-error-filter]');
  const entries=[...(root?.querySelectorAll('[data-error-entry]')||[])];
  const count=root?.querySelector('[data-error-count]');
  const apply=()=>{const query=input.value.trim().toLowerCase();let visible=0;for(const entry of entries){entry.hidden=!!query&&!entry.dataset.search.includes(query);if(!entry.hidden)visible++}for(const group of root.querySelectorAll('[data-error-group]'))group.hidden=![...group.querySelectorAll('[data-error-entry]')].some(entry=>!entry.hidden);count.textContent=query?`${visible} reviewed signal${visible===1?'':'s'} match “${input.value.trim()}”.`:`Showing all ${entries.length} reviewed signals.`};
  input?.addEventListener('input',apply);
</script>
