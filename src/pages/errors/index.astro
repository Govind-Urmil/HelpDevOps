---
import BaseLayout from '../../layouts/BaseLayout.astro';import PageHeader from '../../components/PageHeader.astro';import {errorEntries} from '../../references/discovery.js';
const domains=[...new Set(errorEntries.map(e=>e.domain))].sort();const meta={path:'/errors/',title:'DevOps Error and Symptom Index | HelpDevOps',description:'Browse reviewed DevOps errors and symptoms by domain, understand what they do not prove, and open the safest next diagnostic path.'};
---
<BaseLayout {...meta} breadcrumbs={[{label:'Home',href:'/'},{label:'Errors',href:'/errors/'}]}><PageHeader eyebrow="REVIEWED DISCOVERY INDEX" title="Errors and symptoms, connected to the next safe step" description="This index routes reviewed signals to diagnostic journeys. Matching a phrase is not a root-cause diagnosis."/><section class="section"><div class="container"><p class="muted">Filter enhancements run locally; all essential entries and links are present in this page HTML.</p>{domains.map(domain=><section class="reference-group" id={domain}><h2>{domain[0].toUpperCase()+domain.slice(1)}</h2><div class="error-index">{errorEntries.filter(e=>e.domain===domain).map(e=><article class="reason-panel"><span class="eyebrow">{e.kind.replace('-',' ')}</span><h3>{e.term}</h3><p>{e.summary}</p><p><strong>Does not prove:</strong> {e.doesNotProve}</p><a href={e.route}>Open {e.title}</a></article>)}</div></section>)}</div></section></BaseLayout>
