---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import AnalysisResult from '../../components/results/AnalysisResult.astro';
import {evidenceDefinitions} from '../../core/evidence/registry.js';
const meta={path:'/interpret/',title:'Evidence Interpreter | HelpDevOps',description:'Interpret bounded DevOps command output locally and continue to a reviewed diagnostic journey.'};
---
<BaseLayout {...meta} breadcrumbs={[{label:'Home',href:'/'},{label:'Interpret',href:'/interpret/'}]}>
 <PageHeader eyebrow="EVIDENCE · AVAILABLE" title="Evidence Interpreter" description="Paste supported DevOps evidence, separate observation from interpretation, and find the safest next check without uploading output." />
 <section class="section"><div class="container tool-workspace" data-evidence-root data-tool-root>
  <div class="tool-input-panel"><label for="evidence-source">Where did this output come from?</label><select id="evidence-source" name="evidence-source" data-source><option value="auto">Auto-detect</option>{evidenceDefinitions.map(item=><option value={item.id}>{item.source}</option>)}</select><label for="evidence-input">Focused command output</label><textarea id="evidence-input" name="evidence-input" rows="16" data-tool-input placeholder="Paste supported df, Kubernetes Pod, Docker State, Terraform lock, or systemd evidence…"></textarea><label class="checkbox-row"><input type="checkbox" id="save-raw-evidence" name="save-raw-evidence" data-save-raw-evidence /> Include raw evidence when explicitly saving a workspace</label><input type="hidden" id="evidence-summary" name="evidence-summary" value="" data-evidence-summary /><div class="tool-actions"><button class="button primary" type="button" data-interpret>Interpret</button><button class="button ghost" type="button" data-clear>Clear</button></div><p class="muted">Nothing is uploaded or saved automatically. Before explicit save or export, review and redact sensitive operational details.</p></div>
  <AnalysisResult />
  <aside class="reference-panel"><h2>Supported evidence</h2><ul>{evidenceDefinitions.map(item=><li><a href={`/interpret/${item.slug}/`}>{item.title}</a></li>)}</ul><h3>Privacy-first saving</h3><p>Workspace saving is explicit. For minimum exposure, save only after reviewing the raw output and removing credentials, private keys, authorization values, Secret data, internal names, or unnecessary paths.</p></aside>
 </div></section>
</BaseLayout>
<script>
 // @ts-nocheck
 import {interpretEvidence} from '../../core/evidence/interpreter.js';import {evidenceById} from '../../core/evidence/registry.js';import {publishedJourneys} from '../../diagnostics/registry.js';
 const root=document.querySelector('[data-evidence-root]'),input=root.querySelector('[data-tool-input]'),source=root.querySelector('[data-source]');
 const fill=result=>{const q=s=>root.querySelector(s);const list=(s,items)=>{q(s).replaceChildren(...(items?.length?items:['None for this result.']).map(item=>{const li=document.createElement('li');li.textContent=typeof item==='string'?item:(item.message||item.label||String(item));return li;}))};q('[data-result-kind]').textContent=(result.recognition?.status||result.kind||'evidence').toUpperCase();q('[data-result-title]').textContent=result.title;q('[data-result-status]').textContent=result.status.toUpperCase();q('[data-result-summary]').textContent=result.summary;list('[data-result-evidence]',[...(result.observations||[]).map(o=>`${o.label}: ${o.value}`),...(result.interpretations||[])]);list('[data-result-actions]',result.actions);list('[data-result-checked]',result.checked);list('[data-result-not-checked]',result.unknowns||result.notChecked);list('[data-result-next]',result.nextChecks||result.nextActions);const wrap=q('[data-formatted-wrap]');wrap.hidden=!result.formatted;if(result.formatted)q('[data-formatted-output]').textContent=result.formatted;const sendWrap=q('[data-send-wrap]');const send=q('[data-send-result]');const def=result.parserId?evidenceById.get(result.parserId):null;const journeyId=result.relatedJourneyId||def?.relatedJourneyId;const journey=publishedJourneys.find(item=>item.id===journeyId);sendWrap.hidden=!journey;if(journey){send.textContent='Open reviewed diagnostic journey →';send.onclick=()=>location.href=journey.path;}root.querySelector('[data-evidence-summary]').value=JSON.stringify({parserId:result.parserId,recognition:result.recognition,observations:result.observations||[],interpretations:result.interpretations||[],unknowns:result.unknowns||[],nextChecks:result.nextChecks||[],relatedJourneyId:result.relatedJourneyId||null});const panel=q('[data-analysis-result]');panel.hidden=false;panel.focus();};
 root.querySelector('[data-interpret]').addEventListener('click',()=>fill(interpretEvidence(input.value,{source:source.value})));root.querySelector('[data-clear]').addEventListener('click',()=>{input.value='';source.value='auto';root.querySelector('[data-evidence-summary]').value='';root.querySelector('[data-analysis-result]').hidden=true;input.focus()});const initialSource=new URLSearchParams(location.search).get('source');if(initialSource&&evidenceById.has(initialSource))source.value=initialSource;const restoreSavedInterpretation=()=>{const raw=root.querySelector('[data-evidence-summary]').value;if(!input.value&&raw){try{const saved=JSON.parse(raw);fill({status:'recognized',kind:`evidence:${saved.parserId}`,parserId:saved.parserId,title:evidenceById.get(saved.parserId)?.title||'Saved evidence interpretation',summary:'Restored interpretation-only workspace state. Raw evidence was not saved.',recognition:saved.recognition,observations:saved.observations,interpretations:saved.interpretations,unknowns:saved.unknowns,nextChecks:saved.nextChecks,relatedJourneyId:saved.relatedJourneyId,checked:['Saved structured interpretation'],notChecked:saved.unknowns,actions:[],evidence:[],nextActions:saved.nextChecks});}catch{}}};document.addEventListener('helpdevops:workspace-state-restored',event=>{if(event.detail?.toolId==='evidence-interpreter')restoreSavedInterpretation()});setTimeout(restoreSavedInterpretation,0);root.querySelector('[data-copy-output]')?.addEventListener('click',async()=>navigator.clipboard.writeText(root.querySelector('[data-formatted-output]').textContent));
</script>
