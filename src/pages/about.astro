---
import StatusPage from '../components/StatusPage.astro'; import {pageMetadata as m} from '../config/pages.js';
const sections=[{label:'MISSION',title:'A companion for the work between documentation tabs',text:'HelpDevOps is built to help DevOps, platform, cloud, SRE, and infrastructure engineers understand tasks, act safely, and keep context together.'},{label:'PRODUCT PRINCIPLE',title:'Trust before feature count',text:'Accuracy, transparent reasoning, safe failure, and visible limitations are release requirements—not optional polish.'},{label:'ARCHITECTURE',title:'Static-first and browser-first',text:'The default architecture avoids accounts, backends, required remote APIs, and unnecessary dependencies.'}];
---
<StatusPage meta={m.about} eyebrow="ABOUT" title="Built for engineering flow" description="HelpDevOps is a long-term, privacy-first DevOps task workspace—not a generic utility collection or AI wrapper." sections={sections}/>
