---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import AnalysisResult from '../../components/results/AnalysisResult.astro';
import examples from '../../tools/structured-data/examples.json';
import resources from '../../tools/structured-data/resources.json';
const meta={path:'/tools/structured-data/',title:'JSON & YAML Inspector | HelpDevOps',description:'Parse, inspect, and format JSON or YAML locally with transparent limits.'};
---
<BaseLayout {...meta} breadcrumbs={[{label:'Home',href:'/'},{label:'Tools',href:'/tools/'},{label:'JSON & YAML Inspector',href:'/tools/structured-data/'}]}>
  <PageHeader eyebrow="CONFIGURATION · AVAILABLE" title="JSON & YAML Inspector" description="Parse, inspect, and safely format structured data locally in your browser." />
  <section class="section"><div class="container tool-workspace" data-structured-root>
    <div class="tool-input-panel"><label for="structured-input">JSON or YAML</label><textarea id="structured-input" rows="12" data-structured-input placeholder="Paste JSON or YAML…"></textarea><div class="example-row">{examples.map(example=><button type="button" data-example={example.input}>{example.label}</button>)}</div><div class="tool-actions"><button class="button primary" type="button" data-inspect>Inspect</button><button class="button secondary" type="button" data-minify>Minify JSON</button><button class="button ghost" type="button" data-clear>Clear</button></div></div>
    <AnalysisResult />
    <aside class="reference-panel"><h2>Local analysis</h2><p>Input stays in this browser tab and is not stored or uploaded.</p><h3>Visible limitations</h3><ul>{resources.limitations.map(item=><li>{item}</li>)}</ul></aside>
  </div></section>
</BaseLayout>
<script>
  // @ts-nocheck
  import {detectAndAnalyze,analyzeJson} from '../../tools/structured-data/analyzer.js';
  const root=document.querySelector('[data-structured-root]');const input=root.querySelector('[data-structured-input]');
  const fill=result=>{const q=s=>root.querySelector(s);const list=(s,items)=>{q(s).replaceChildren(...(items?.length?items:['None for this result.']).map(item=>{const li=document.createElement('li');li.textContent=typeof item==='string'?item:item.label;return li;}))};q('[data-result-kind]').textContent=(result.kind||'unknown').toUpperCase();q('[data-result-title]').textContent=result.classification?`${result.title} · ${result.classification.label}`:result.title;q('[data-result-status]').textContent=result.status.toUpperCase();q('[data-result-summary]').textContent=result.summary;list('[data-result-evidence]',[...(result.evidence||[]).map(e=>`${e.signal}: ${e.excerpt}`),...(result.classification?[`Classification evidence: ${result.classification.evidence.join(', ')}`]:[])]);list('[data-result-actions]',result.actions);list('[data-result-checked]',result.checked);list('[data-result-not-checked]',result.notChecked);list('[data-result-next]',result.nextActions);const wrap=q('[data-formatted-wrap]');wrap.hidden=!result.formatted;if(result.formatted)q('[data-formatted-output]').textContent=result.formatted;const panel=q('[data-analysis-result]');panel.hidden=false;panel.focus()};
  root.querySelector('[data-inspect]').addEventListener('click',()=>fill(detectAndAnalyze(input.value)||{status:'unsupported',kind:'unknown',title:'Input not recognized',summary:'Enter JSON or YAML.',evidence:[],actions:[],checked:['JSON and YAML parse attempts'],notChecked:[],nextActions:['Load an example.']}));root.querySelector('[data-minify]').addEventListener('click',()=>{const result=analyzeJson(input.value);if(result.compact){input.value=result.compact;result.formatted=result.compact;}fill(result)});root.querySelector('[data-clear]').addEventListener('click',()=>{input.value='';root.querySelector('[data-analysis-result]').hidden=true;input.focus()});root.querySelectorAll('[data-example]').forEach(button=>button.addEventListener('click',()=>{input.value=button.dataset.example;input.focus()}));root.querySelector('[data-copy-output]')?.addEventListener('click',async()=>navigator.clipboard.writeText(root.querySelector('[data-formatted-output]').textContent));
</script>
