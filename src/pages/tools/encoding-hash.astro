---
import BaseLayout from '../../layouts/BaseLayout.astro';import PageHeader from '../../components/PageHeader.astro';import resources from '../../tools/encoding-hash/resources.json';const meta={path:'/tools/encoding-hash/',title:'Encoding & Hash Workbench | HelpDevOps',description:'Transform UTF-8 text and calculate SHA-2 hashes locally.'};
---
<BaseLayout {...meta}><PageHeader eyebrow="DEVELOPER ESSENTIALS · AVAILABLE" title="Encoding & Hash Workbench" description="UTF-8 Base64, Base64URL, hex, URI-component transformations, and browser-native SHA-2 hashing."/><section class="section"><div class="container tool-workspace" data-tool-root><div class="tool-input-panel"><label for="encoding-input">Text or encoded input</label><textarea id="encoding-input" rows="8" data-input></textarea><div class="tool-actions"><select data-operation aria-label="Operation">{resources.operations.map(x=><option value={x}>{x}</option>)}</select><label><input type="checkbox" data-tolerant/> Tolerant decode</label><button class="button primary" data-transform>Transform</button><select data-hash aria-label="Hash algorithm">{resources.hashAlgorithms.map(x=><option>{x}</option>)}</select><button class="button secondary" data-digest>Hash UTF-8</button><button class="button ghost" data-clear>Clear</button></div><p data-status aria-live="polite"></p><pre data-output></pre></div><aside class="reference-panel"><h2>Truthful limits</h2><ul>{resources.limitations.map(x=><li>{x}</li>)}</ul></aside></div></section></BaseLayout>
<script>
// @ts-nocheck
import {transformText,hashText} from '../../tools/encoding-hash/analyzer.js';const r=document.querySelector('[data-tool-root]'),i=r.querySelector('[data-input]'),o=r.querySelector('[data-output]'),s=r.querySelector('[data-status]');r.querySelector('[data-transform]').onclick=()=>{const x=transformText(i.value,r.querySelector('[data-operation]').value,{tolerant:r.querySelector('[data-tolerant]').checked});s.textContent=`${x.title}: ${x.summary}`;o.textContent=x.output||''};r.querySelector('[data-digest]').onclick=async()=>{const x=await hashText(i.value,r.querySelector('[data-hash]').value);s.textContent=`${x.title}: ${x.summary}`;o.textContent=x.hex?`Hex: ${x.hex}\nBase64: ${x.base64}\nBytes: ${x.byteCount}`:''};r.querySelector('[data-clear]').onclick=()=>{i.value='';o.textContent='';s.textContent='';i.focus()}</script>
