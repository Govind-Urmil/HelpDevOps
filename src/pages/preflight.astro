---
import StatusPage from '../components/StatusPage.astro'; import {pageMetadata as m} from '../config/pages.js';
const sections=[{label:'STATUS',title:'Preflight does not run checks yet',text:'This release provides only the platform and interaction contract. Do not use this page to assess whether configuration files work together.'},{label:'PLANNED FLOW',title:'Add files → inspect relationships → explain findings',text:'A future researched subset will inspect selected relationships across Dockerfile, Compose, environment, and Kubernetes configuration locally.'},{label:'TRANSPARENCY',title:'Every finding will name its boundary',text:'Preflight results will distinguish checked relationships from unsupported or unexamined behavior, with evidence and next actions.'}];
---
<StatusPage meta={m.preflight} eyebrow="PREFLIGHT" title="DevOps Preflight" description="The planned cross-file compatibility workflow for selected DevOps files. It is not operational in EP-003." status="In development" sections={sections}/>
